datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/client"
}

// ----------------------------------------------------
// 0. MULTI-BRANCH SYSTEM (منظومة الفروع المتعددة)
// ----------------------------------------------------
model Branch {
  id           String                @id @default(cuid())
  name         String                // e.g. "فرع حدائق القبة (الرئيسي)", "فرع الوايلي الكبير"
  code         String                @unique // "HQ-QOBBA", "BR-WAYLI"
  address      String
  phone        String
  whatsapp     String?
  isActive     Boolean               @default(true)
  createdAt    DateTime              @default(now())
  users        User[]
  orders       Order[]
  stocks       BranchStock[]
  transactions TreasuryTransaction[]
}

// ----------------------------------------------------
// 1. STAFF & ROLE-BASED USERS (المستخدمين والصلاحيات)
// ----------------------------------------------------
model User {
  id           String    @id @default(cuid())
  name         String
  username     String    @unique
  passwordHash String
  pin          String    @default("157230") // PIN Code مخفي في الواجهة
  phone        String?   @unique
  role         String    @default("owner") // owner (Maestro), manager, cashier, delivery, chef
  branchId     String?   // null للمالك والمدير العام (إشراف كامل على كل الفروع)، أو محدد لموظف الفرع
  branch       Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  permissions  String?   // JSON array: ["pos", "inventory", "orders", "settings", "reports", "users"]
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
}

// ----------------------------------------------------
// 2. DYNAMIC CATEGORIES (الأقسام الديناميكية)
// ----------------------------------------------------
model Category {
  id          String    @id @default(cuid())
  nameAr      String    @unique
  nameEn      String?
  icon        String?
  description String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  products    Product[]
}

// ----------------------------------------------------
// 3. DYNAMIC PRODUCTS & SCALE MENU (المنتجات والموازين)
// ----------------------------------------------------
model Product {
  id           String        @id @default(cuid())
  nameAr       String
  nameEn       String?
  categoryId   String
  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryName String
  unit         String        @default("1 كجم") // 1 كجم، قطعة، طبق، علبة، طاجن
  barcode      String?       @unique
  pluCode      String?       // كود ميزان الباركود الإلكتروني
  isWeighted   Boolean       @default(false)
  pricePerKg   Float?        // سعر الكيلو للأصناف الوزنية
  basePrice    Float         // سعر بيع الوحدة أو الكيلو
  costPrice    Float         @default(0) // تكلفة الإنتاج أو الشراء
  isHouseMade  Boolean       @default(true)
  inStock      Boolean       @default(true)
  stockQty     Float         @default(100) // إجمالي المخزن عبر الفروع
  minStockQty  Float         @default(10)
  image        String?
  description  String?
  badge        String?       // "صنع فينيسيا 🥛", "طازج اليوم ⭐", "مش بس لبن"
  sortOrder    Int           @default(0)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  branchStocks BranchStock[]
}

// ----------------------------------------------------
// 3.1 BRANCH SPECIFIC INVENTORY (مخزن وبضاعة كل فرع مستقلة)
// ----------------------------------------------------
model BranchStock {
  id            String    @id @default(cuid())
  branchId      String
  branch        Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  productId     String
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockQty      Float     @default(0) // الرصيد الفعلي الحالي بالفرع
  openingStock  Float     @default(0) // مخزون أول المدة (الجرد الفعلي عند التثبيت)
  totalIn       Float     @default(0) // إجمالي الوارد والتوريدات
  totalOut      Float     @default(0) // إجمالي المنصرف ومبيعات الكاشير
  minStockQty   Float     @default(10)
  lastAuditDate DateTime?
  updatedAt     DateTime  @updatedAt

  @@unique([branchId, productId])
}

// ----------------------------------------------------
// 3.2 STOCK MOVEMENT / CARD (كارت الصنف وسجل الحركات)
// ----------------------------------------------------
model StockMovement {
  id           String   @id @default(cuid())
  branchId     String
  productId    String
  productName  String
  type         String   // "OPENING" (مخزون أول المدة), "SUPPLY" (إذن توريد), "SALE" (بيع كاشير/دليفري), "AUDIT_ADJUST" (تسوية جرد)
  qty          Float    // الكمية (+ أو -)
  balanceAfter Float
  reference    String?  // رقم الفاتورة أو إذن التوريد
  notes        String?
  recordedBy   String?
  createdAt    DateTime @default(now())
}

// ----------------------------------------------------
// 4. CUSTOMERS & VERIFICATION (العملاء وتوثيق الدليفري)
// ----------------------------------------------------
model Customer {
  id                 String    @id @default(cuid())
  name               String
  phone              String    @unique
  email              String?
  username           String?   @unique
  password           String?
  address            String?
  zone               String?
  landmark           String?
  notes              String?
  isVerified         Boolean   @default(false)
  verificationMethod String?
  otpCode            String?
  otpExpires         DateTime?
  totalOrders        Int       @default(0)
  totalSpent         Float     @default(0)
  createdAt          DateTime  @default(now())
  orders             Order[]
}

// ----------------------------------------------------
// 5. ORDERS & DELIVERY (إدارة الطلبات الحية: صالة + دليفري)
// ----------------------------------------------------
model Order {
  id              String    @id @default(cuid())
  orderNumber     String    @unique // VIN-1001
  branchId        String?
  branch          Branch?   @relation(fields: [branchId], references: [id])
  orderType       String    @default("delivery") // pos (صالة), delivery (توصيل), takeaway (استلام من الفرع)
  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id])
  customerName    String
  customerPhone   String
  deliveryAddress String?
  deliveryZone    String?
  items           String    // JSON: [{productId, nameAr, unit, qty, weightGrams, isWeighted, unitPrice, total}]
  subtotal        Float
  deliveryFee     Float     @default(15)
  discount        Float     @default(0)
  totalAmount     Float
  paymentMethod   String    @default("cash") // cash, instapay, vodafone_cash, card
  status          String    @default("PENDING") // PENDING, PREPARING, OUT_FOR_DELIVERY, DELIVERED, CANCELLED
  courierId       String?
  courier         Courier?  @relation(fields: [courierId], references: [id])
  cashierName     String?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// ----------------------------------------------------
// 6. COURIERS & FLEET (أسطول طياري الدليفري)
// ----------------------------------------------------
model Courier {
  id                String   @id @default(cuid())
  name              String
  phone             String   @unique
  vehicleType       String?  @default("موتوسيكل سريع")
  branchId          String?
  branchName        String?
  isAvailable       Boolean  @default(true)
  activeOrdersCount Int      @default(0)
  pendingCash       Float    @default(0)
  createdAt         DateTime @default(now())
  orders            Order[]
}

// ----------------------------------------------------
// 7. SYSTEM SETTINGS (الإعدادات العامة الديناميكية)
// ----------------------------------------------------
model SystemSettings {
  id                String   @id @default("default")
  storeName         String   @default("ألبان فينيسيا")
  tagline           String   @default("مش بس لبن وزبادي — خير المزارع الطبيعي على أصوله")
  address           String   @default("80 المدينة المنورة، الوايلي الكبير شرق، حدائق القبة، محافظة القاهرة")
  googleMapsUrl     String   @default("https://share.google/UrPJjxJ0JpFBb4OHt")
  phone             String   @default("0224382540")
  hotline           String   @default("01018671000")
  whatsapp          String   @default("01018671000")
  deliveryZones     String   @default("[{\"name\":\"حدائق القبة والوايلي الكبير\",\"fee\":15,\"time\":30},{\"name\":\"الزاوية الحمراء ودير الملاك\",\"fee\":20,\"time\":40},{\"name\":\"منشية الصدر والعباسية\",\"fee\":25,\"time\":45}]")
  minDeliveryOrder  Float    @default(50)
  freeDeliveryAbove Float    @default(350)
  isOpen            Boolean  @default(true)
  workingHours      String   @default("يومياً من 7:00 صباحاً حتى 2:00 بعد منتصف الليل")
  weightScalePrefix String   @default("20,21")
  announcement      String?  @default("🥛 ألبان طازجة وارد اليوم من المزرعة مباشرة — مش بس لبن وزبادي!")
  updatedAt         DateTime @updatedAt
}

// ----------------------------------------------------
// 8. TREASURY TRANSACTIONS (حركات الخزينة والوردية)
// ----------------------------------------------------
model TreasuryTransaction {
  id           String   @id @default(cuid())
  branchId     String?
  branch       Branch?  @relation(fields: [branchId], references: [id])
  type         String   // IN, OUT
  category     String   // POS_SALE, DELIVERY_COLLECTION, EXPENSE, SUPPLIER
  amount       Float
  balanceAfter Float    @default(0)
  description  String
  reference    String?
  recordedBy   String?
  createdAt    DateTime @default(now())
}
